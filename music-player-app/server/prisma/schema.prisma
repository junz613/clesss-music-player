generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Song {
  id         String     @id @default(uuid()) @db.VarChar(36)
  title      String     @db.VarChar(512)
  artist     String?    @db.VarChar(512)
  album      String?    @db.VarChar(512)
  duration   Int?
  folder     String     @db.VarChar(512)
  fileName   String     @db.VarChar(512)
  filePath   String     @db.VarChar(1024)
  fileKey    String     @unique @db.VarChar(64)
  playUrl    String?    @db.VarChar(255)
  sourceType String     @default("local") @db.VarChar(32)
  isDeleted  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  favorites  Favorite[]

  @@index([title])
  @@index([folder])
  @@index([isDeleted])
  @@map("songs")
}

model Favorite {
  id        String   @id @default(uuid()) @db.VarChar(36)
  songId    String   @db.VarChar(36)
  userKey   String   @default("local-user") @db.VarChar(128)
  createdAt DateTime @default(now())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, userKey])
  @@index([userKey])
  @@map("favorites")
}
